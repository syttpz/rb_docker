# ROS2 / colcon build artifacts (also see src/bridge_node/.gitignore, which
# covers build/install/log for that package specifically)
build/
install/
log/
compile_commands.json

# rtabmap map outputs written at runtime -- large binary data, not source
src/maps/*
!src/maps/.gitkeep

# rtabmap databases from offload runs -- large binary experiment output
*.db

# python bytecode from launch files
__pycache__/
*.pyc

# downloaded/converted test rosbags -- multi-GB, re-fetchable via datasets/README.md
datasets/*
!datasets/README.md
!datasets/prepare_tum_ros2.py
!datasets/fetch_tum.sh

# local Claude Code settings (machine-specific, not shared)
.claude/settings.local.json

# scratch test command sheets (machine-specific paths, not part of the package)
src/bridge_node/battery_state_test.txt

# editor / OS cruft
.vscode/
.idea/
.cache/
.DS_Store
*.swp
*.swo
*~
